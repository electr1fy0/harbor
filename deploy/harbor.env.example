# Read by the single root-owned daemon/dashboard service.
# Keep /etc/harbor/harbor.env root:root and mode 0600.
PAASD_PUBLIC_ORIGIN=https://dashboard.example.com
PAASD_ADMIN_PASSWORD_HASH=
PAASD_SESSION_SECRET=
GITHUB_TOKEN=
# Optional: enables user-requested failure explanations using gpt-5.4-mini.
# Keep this daemon credential out of application environment settings.
OPENAI_API_KEY=
