[Unit]
Description=Harbor deployment control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
RuntimeDirectory=paas
RuntimeDirectoryMode=0755
StateDirectory=paas
StateDirectoryMode=0755
UMask=0077
EnvironmentFile=/etc/harbor/harbor.env
ExecStart=/usr/local/bin/paasd -socket /run/paas/paasd.sock -socket-group paas-admins -data-dir /var/lib/paas -listen 127.0.0.1:8080 -tls-ask-listen 127.0.0.1:8081 -web-listen 127.0.0.1:3000
Restart=on-failure
RestartSec=2
TimeoutStopSec=150
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
