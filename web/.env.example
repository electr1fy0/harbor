# Optional GitHub API token, used only by the server-side dashboard.
# GITHUB_TOKEN=

# Leave all three values unset for loopback-only local development.
# Set all three for public HTTPS mode. Incomplete or malformed auth settings
# make the dashboard fail closed.
# PAASD_PUBLIC_ORIGIN=https://dashboard.example.com
# PAASD_ADMIN_PASSWORD_HASH=scrypt$32768$8$1$salt-hex$hash-hex
# PAASD_SESSION_SECRET=64-lowercase-hex-characters-from-openssl-rand-hex-32

# The daemon control socket defaults to /run/paas/paasd.sock.
# PAASD_SOCKET=/tmp/paasd.sock
