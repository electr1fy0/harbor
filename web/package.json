{
  "name": "web",
  "private": true,
  "packageManager": "bun@1.4.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev --host 127.0.0.1 --port 5173",
    "generate-routes": "tsr generate",
    "build": "vite build && printf 'Embedded frontend build output is generated here.\\n' > dist/.gitkeep",
    "test": "vitest run --config vitest.config.ts",
    "preview": "vite preview",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx}\"",
    "check": "prettier --check \"**/*.{ts,tsx,js,jsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@tabler/icons-react": "^3.49.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-table": "^9.2.8",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tanstack/eslint-config": "latest",
    "@tanstack/router-cli": "^1.167.39",
    "@tanstack/router-plugin": "^1.168.42",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.2",
    "vite": "^8",
    "vitest": "^5.0.3"
  }
}
